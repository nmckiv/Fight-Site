@model Fall2024_FinalProject.Models.Bet

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Bet</h1>

<hr />
<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="Edit" class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <!-- User -->
                <div class="form-group mb-3">
                    <label asp-for="UserId" class="form-label">User</label>
                    <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <!-- Fight -->
                <div class="form-group mb-3">
                    <label asp-for="FightId" class="form-label">Event</label>
                    <select asp-for="FightId" class="form-select" asp-items="ViewBag.FightId"></select>
                    <span asp-validation-for="FightId" class="text-danger"></span>
                </div>

                <!-- Chosen Fighter -->
                <div class="form-group mb-3">
                    <label asp-for="ChosenFighterId" class="form-label">Chosen Fighter</label>
                    <select asp-for="ChosenFighterId" class="form-select" asp-items="ViewBag.ChosenFighterId"></select>
                    <span asp-validation-for="ChosenFighterId" class="text-danger"></span>
                </div>

                <!-- Bet Amount -->
                <div class="form-group mb-3">
                    <label asp-for="BetAmount" class="form-label">Bet Amount</label>
                    <input asp-for="BetAmount" class="form-control" placeholder="Enter bet amount" />
                    <span asp-validation-for="BetAmount" class="text-danger"></span>
                </div>

                <!-- Odds -->
                <div class="form-group mb-3">
                    <label asp-for="Odds" class="form-label">Odds</label>
                    <input asp-for="Odds" class="form-control" placeholder="Enter odds" />
                    <span asp-validation-for="Odds" class="text-danger"></span>
                </div>

                <!-- IsWin -->
                <div class="form-group mb-3">
                    <label asp-for="IsWin" class="form-label">Result</label>
                    <input asp-for="IsWin" class="form-control" placeholder="Enter result (true/false)" />
                    <span asp-validation-for="IsWin" class="text-danger"></span>
                </div>

                <div class="form-group text-center mt-4">
                    <input type="submit" value="Save" class="btn btn-primary btn-lg" />
                </div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
