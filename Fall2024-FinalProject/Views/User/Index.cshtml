@model IEnumerable<Fall2024_FinalProject.Models.User>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center">All Users</h1>

@if (User.IsInRole("Admin"))
{
    <p class="text-center">
        <a asp-action="Create" class="btn btn-success">Create New User</a>
    </p>
}

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1 class="text-center">@item.Name</h1>
                    <!-- Card Layout -->
                    <div class="d-flex">
                        <div class="col-4">
                            @if (item.ProfilePhoto != null)
                            {
                                var base64 = Convert.ToBase64String(item.ProfilePhoto);
                                var imgSrc = $"data:image/jpeg;base64,{base64}";
                                <img src="@imgSrc" alt="Profile Photo" class="img-fluid rounded w-100" style="height: 200px; width: auto; object-fit: cover;" />
                            }
                        </div>

                        <div class="col-8 d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <span class="fs-5 fw-medium">Balance: </span>
                                <span class="fs-5 fw-medium">@item.Balance</span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <span class="fs-5 fw-medium">Role:</span>
                                <span class="fs-5 fw-medium">@item.Role</span>
                            </div>
                        </div>
                    </div>
                    <!-- Buttons Section -->
                    <div class="mt-4">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info me-2">User Details</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary me-2 d-none">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger me-2">Delete</a>
                            <a asp-action="ManageUserRole" asp-route-id="@item.Id" class="btn btn-warning me-2">Change Role</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
