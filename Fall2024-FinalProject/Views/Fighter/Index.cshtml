@model IEnumerable<Fall2024_FinalProject.Models.Fighter>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center">All Fighters</h1>

@if (User.IsInRole("Admin"))
{
    <p class="text-center">
        <a asp-action="Create" class="btn btn-success">Create New Fighter</a>
    </p>
}

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1 class="text-center">@item.Name</h1>
                    <!-- Card Layout -->
                    <div class="d-flex">
                        <!-- Fighter Photo Section (2/3 width) -->
                        <div class="col-8">
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.FighterPhoto)"
                                 alt="Fighter Photo"
                                 class="img-fluid rounded w-100"
                                 style="height: 500px; width: auto; object-fit: cover;" />
                        </div>

                        <!-- Details Section (1/3 width) -->
                        <div class="col-4 d-flex flex-column align-items-center justify-content-center">
                            <div class="d-flex align-items-center mb-2">
                                <img src="/icons/health.svg" alt="Health Icon" width="32" height="32" class="me-2">
                                <span class="fs-5 fw-medium">@item.Health</span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <img src="/icons/strength.svg" alt="Strength Icon" width="32" height="32" class="me-2">
                                <span class="fs-5 fw-medium">@item.Strength</span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <img src="/icons/agility.svg" alt="Agility Icon" width="32" height="32" class="me-2">
                                <span class="fs-5 fw-medium">@item.Agility</span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <img src="/icons/intelligence.svg" alt="Intelligence Icon" width="32" height="32" class="me-2">
                                <span class="fs-5 fw-medium">@item.Intelligence</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <img src="/icons/weight.svg" alt="Weight Icon" width="32" height="32" class="me-2">
                                <span class="fs-5 fw-medium">@item.Weight</span>
                            </div>
                        </div>
                    </div>
                    <!-- Buttons Section -->
                    <div class="mt-4">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info me-2">Fighter Details</a>
                        @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary me-2">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger me-2">Delete</a>
                            }
                    </div>
                </div>
            </div>
        </div>
    }
</div>