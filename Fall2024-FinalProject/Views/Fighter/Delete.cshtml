@model Fall2024_FinalProject.Models.Fighter

@{
    ViewData["Title"] = "Delete";
}

<!-- deletion warning -->
<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
            <p class="mb-0 text-warning fw-bold fs-5 text-center" style="flex-grow: 1;">
                Are you sure you want to delete this fighter? <br> This action cannot be undone!
            </p>
        </div>
    </div>
</div>

<div>
    <div class="card mb-3">
        <div class="card-body">
            <h1 class="text-center">
                @Html.DisplayFor(model => model.Name)
            </h1>
            <div class="row" style="height: 100%;">
                <!-- Left column: Photo and Weight -->
                <div class="col-6 d-flex flex-column align-items-center justify-content-center">
                    <div class="mb-3">
                        @if (Model.FighterPhoto != null && Model.FighterPhoto.Length > 0)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.FighterPhoto)" alt="Fighter Photo" class="img-fluid rounded" style="width:400px;height:auto;" />
                        }
                        else
                        {
                            <p>No photo available</p>
                        }
                    </div>
                    <div class="d-flex">
                        <span class="font-weight-bold me-2">@Html.DisplayNameFor(model => model.Weight):</span>
                        <span>@Html.DisplayFor(model => model.Weight)</span>
                    </div>
                </div>

                <!-- Right column: Stats and Fighting Style -->
                <div class="col-6 d-flex flex-column justify-content-center">
                    <div class="w-100">
                        <dl class="row">
                            @* Health *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-4 text-end">
                                    <span>@Html.DisplayNameFor(model => model.Health)</span>
                                </div>
                                <div class="col-6">
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: @(Model.Health * 10)%;" aria-valuenow="@Model.Health" aria-valuemin="0" aria-valuemax="10"></div>
                                    </div>
                                </div>
                                <div class="col-2">
                                    <span>@Model.Health</span>
                                </div>
                            </div>

                            @* Strength *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-4 text-end">
                                    <span>@Html.DisplayNameFor(model => model.Strength)</span>
                                </div>
                                <div class="col-6">
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: @(Model.Strength * 10)%;" aria-valuenow="@Model.Strength" aria-valuemin="0" aria-valuemax="10"></div>
                                    </div>
                                </div>
                                <div class="col-2">
                                    <span>@Model.Strength</span>
                                </div>
                            </div>

                            @* Agility *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-4 text-end">
                                    <span>@Html.DisplayNameFor(model => model.Agility)</span>
                                </div>
                                <div class="col-6">
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: @(Model.Agility * 10)%;" aria-valuenow="@Model.Agility" aria-valuemin="0" aria-valuemax="10"></div>
                                    </div>
                                </div>
                                <div class="col-2">
                                    <span>@Model.Agility</span>
                                </div>
                            </div>

                            @* Intelligence *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-4 text-end">
                                    <span>@Html.DisplayNameFor(model => model.Intelligence)</span>
                                </div>
                                <div class="col-6">
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: @(Model.Intelligence * 10)%;" aria-valuenow="@Model.Intelligence" aria-valuemin="0" aria-valuemax="10"></div>
                                    </div>
                                </div>
                                <div class="col-2">
                                    <span>@Model.Intelligence</span>
                                </div>
                            </div>

                            @* Fighting Style *@
                            <div class="row mb-3 align-items-center">
                                <div class="col-4 text-end">
                                    <span>@Html.DisplayNameFor(model => model.FighterStyle)</span>
                                </div>
                                <div class="col-8">
                                    <span>@Html.DisplayFor(model => model.FighterStyle)</span>
                                </div>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger me-2" />
        <a asp-action="Index" class="btn btn-secondary me-2">Back to List</a>
    </form>
</div>
