@model Fall2024_FinalProject.Models.FightAggregate

@{
    ViewData["Title"] = "Fight Details";
}

<h1>Fight Details</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h3 class="card-title">@Model.Fighter1.Name</h3>
                <div class="col-8">
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Fighter1.FighterPhoto)"
                         alt="Fighter Photo"
                         class="fixed-size-img img-fluid rounded w-100" />
                </div>      
                <strong>Odds:</strong> @Html.DisplayFor(model => model.Fight.Fighter1Odds)<br />

                <p>
                    <a asp-action="Details" asp-controller="Fighter" asp-route-id="@Model.Fighter1.Id" class="btn btn-info">View Fighter Details</a>
                </p>
            </div>
            <div class="col-md-6">
                <h3 class="card-title">@Model.Fighter2.Name</h3>
                <div class="col-8">
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Fighter2.FighterPhoto)"
                         alt="Fighter Photo"
                         class="fixed-size-img img-fluid rounded w-100" />
                </div>
                <strong>Odds:</strong> @Html.DisplayFor(model => model.Fight.Fighter2Odds)<br />

                <p>
                    <a asp-action="Details" asp-controller="Fighter" asp-route-id="@Model.Fighter2.Id" class="btn btn-info">View Fighter Details</a>
                </p>
            </div>
        </div>
        <hr />
        <h4 class="card-subtitle mb-2 text-muted">Fight Information</h4>
        <p class="card-text">
            <strong>Date:</strong> @Html.DisplayFor(model => model.Fight.Date)<br />
            <strong>Location:</strong>  @Html.DisplayFor(model => model.Fight.Location)<br />

        </p>
        @if (Model.Fight.Winner != null)
        {
            <h4 class="card-subtitle mb-2 text-muted">Fight Simulation Result</h4>
            <p class="card-text">
                <strong>Summary:</strong> @Model.Fight.Summary<br />
                <strong>Rounds Fought:</strong> @Model.Fight.RoundsFought<br />
                <strong>Winner:</strong> @Model.Fight.Winner<br />
            </p>
        }
        else
        {
            <p>
                <a class="btn btn-success" asp-controller="Bet" asp-action="Create">Place Bet!</a>
                
                <!--  WALTA admin access here -->
                @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-primary" asp-action="SimulateFight" asp-route-id="@Model.Fight.Id">Simulate Fight</a>
                        <a asp-action="Edit" asp-route-id="@Model.Fight.Id" class="btn btn-secondary">Edit</a>
                    }
            </p>
        }
        <p>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>

        </p>
    </div>
</div>

